{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eprkit",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-27",
  "routes": [{ "pattern": "eprkit.com", "custom_domain": true }],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Plain settings for upload alerts. Secrets (INTAKE_SECRET, RESEND_API_KEY) are set in the
  // Cloudflare dashboard: Workers & Pages > eprkit > Settings > Variables and secrets.
  "vars": {
    "NOTIFY_TO": "support@eprkit.com",
    "NOTIFY_FROM": "EPR Kit uploads <uploads@updates.eprkit.com>"
  },
  // The private upload bucket (created Nov 27, 2026).
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "eprkit-intake" }],
  // Every 10 minutes: save finished Shopify bulk exports to the bucket (worker/shopify.js).
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
